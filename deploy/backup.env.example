# Configuration des sauvegardes — à copier en /etc/mk-delices/backup.env (root:root, chmod 600), jamais dans Git.
# Lue par deploy/scripts/backup.sh (cron root, 02:00).

# Empreinte de la clé PUBLIQUE de sauvegarde (gpg --import cle-publique.asc ; la clé privée reste hors serveur).
GPG_RECIPIENT=<empreinte GPG>

# Copie hors serveur (obligatoire) : remote rclone configuré dans /root/.config/rclone/rclone.conf,
# idéalement un bucket avec versionnage et verrouillage d'objets, identifiants en écriture seule.
RCLONE_REMOTE=<remote>:mk-delices-backups

# Sonde de supervision appelée après chaque sauvegarde réussie (alerte si aucun appel en 26 h).
HEARTBEAT_URL=

# Base à sauvegarder (mot de passe dans /root/.pgpass, chmod 600).
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=mk_backup
PGDATABASE=mk_delices

BACKUP_DIR=/var/backups/mk-delices
RETENTION_DAYS=14
MEDIA_DIR=/var/www/mk-delices/backend/storage/app/public
