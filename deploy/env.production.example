# Modèle de configuration de PRODUCTION — à copier en backend/.env sur le serveur (jamais dans Git).
# Toutes les valeurs entre <> sont à fournir. Aucune ne doit rester vide si elle est marquée « requis ».

APP_NAME="MK Délices"
APP_ENV=production
APP_DEBUG=false                          # requis : jamais true en production
APP_KEY=                                 # requis : php artisan key:generate --show
APP_URL=https://<domaine>
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_TIMEZONE_BUSINESS=Africa/Dakar
FRONTEND_URL=https://<domaine>           # même domaine que le SPA (redirections PSP, sitemap)
SPA_INDEX_PATH=/var/www/mk-delices/frontend/dist/index.html

# Proxys de confiance : vide = aucun (Nginx en frontal direct). À renseigner seulement derrière un CDN/répartiteur.
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_STACK=daily                           # ajouter « ,slack » une fois LOG_SLACK_WEBHOOK_URL renseignée (alertes sur erreurs)
LOG_SLACK_WEBHOOK_URL=                   # URL de webhook entrant Slack (ou compatible) pour les alertes
LOG_SLACK_LEVEL=error
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1                        # PostgreSQL non exposé sur Internet
DB_PORT=5432
DB_DATABASE=mk_delices
DB_USERNAME=mk_app                       # compte applicatif dédié, sans droits superutilisateur
DB_PASSWORD=<secret>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true               # requis (HTTPS)
SESSION_SAME_SITE=lax
SESSION_DOMAIN=<domaine>
SANCTUM_STATEFUL_DOMAINS=<domaine>

CACHE_STORE=database                     # ou redis si disponible
QUEUE_CONNECTION=database                # worker supervisé : deploy/supervisor/
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=<smtp>
MAIL_PORT=587
MAIL_USERNAME=<utilisateur>
MAIL_PASSWORD=<secret>
MAIL_FROM_ADDRESS="commandes@<domaine>"
MAIL_FROM_NAME="MK Délices"

# Paiements — activer un moyen dans Back-office › Paramètres seulement après validation en sandbox.
PAYMENTS_SIMULATOR_ENABLED=false         # ignoré en production de toute façon
WAVE_API_KEY=<secret fourni par Wave>
WAVE_WEBHOOK_SECRET=<secret fourni par Wave>
WAVE_API_BASE=https://api.wave.com
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_WEBHOOK_SECRET=

# Supervision (/health, sonde externe toutes les 5 min) : horodatage écrit par deploy/scripts/backup.sh.
HEALTH_BACKUP_STATUS_FILE=/var/lib/mk-delices/last-backup
