# Modèle de configuration de PRÉPRODUCTION (staging) — à copier en backend/.env sur le serveur (jamais dans Git).
# Préproduction = site de validation protégé par mot de passe Nginx, paiement SIMULÉ, données de démonstration.
# Aucun paiement réel, aucune indexation. Les secrets <...> sont générés sur le serveur.

APP_NAME="MK Délices (préproduction)"
APP_ENV=staging                          # active le simulateur de paiement et autorise les données de démonstration
APP_DEBUG=false                          # jamais true sur un serveur accessible depuis Internet
APP_KEY=                                 # php artisan key:generate
APP_URL=https://<domaine>
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_TIMEZONE_BUSINESS=Africa/Dakar
FRONTEND_URL=https://<domaine>
# Noms d'hôte acceptés en plus de ceux d'APP_URL et FRONTEND_URL (virgules). Les autres reçoivent une erreur.
TRUSTED_HOSTS=
SPA_INDEX_PATH=/var/www/mk-delices-staging/frontend/dist/index.html

# Proxys de confiance : vide = aucun (Nginx en frontal direct). À renseigner seulement derrière un CDN/répartiteur.
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_STACK=daily                           # ajouter « ,slack » une fois LOG_SLACK_WEBHOOK_URL renseignée (alertes sur erreurs)
LOG_SLACK_WEBHOOK_URL=                   # URL de webhook entrant Slack (ou compatible) pour les alertes
LOG_SLACK_LEVEL=error
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mk_delices_staging
DB_USERNAME=mk_app
DB_PASSWORD=<secret>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=<domaine>
SANCTUM_STATEFUL_DOMAINS=<domaine>

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Emails : capturés localement (journal), jamais envoyés à de vrais destinataires en préproduction.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="preprod@<domaine>"
MAIL_FROM_NAME="MK Délices (préproduction)"

# Notifications du navigateur aux livreurs : clés générées par `php artisan mk:vapid-keys` (une fois par
# environnement). Vide = fonction désactivée. La clé privée est un secret : jamais dans Git.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT="mailto:contact@<domaine>"

PAYMENTS_SIMULATOR_ENABLED=true
PAYMENTS_SIMULATOR_SECRET=<secret>       # openssl rand -hex 32

# Supervision (/health, sonde externe toutes les 5 min) : horodatage écrit par deploy/scripts/backup.sh.
HEALTH_BACKUP_STATUS_FILE=/var/lib/mk-delices/last-backup

# Compte administrateur de démonstration (12 caractères minimum). Vide : mot de passe aléatoire affiché une fois au db:seed.
DEMO_ADMIN_PASSWORD=
